# Copie para .env.local e preencha. Nunca commite valores reais.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# TMDB: Settings > API > "API Read Access Token" (somente servidor)
TMDB_READ_TOKEN=

# Opcional: URL base da API do TMDB (padrão https://api.themoviedb.org/3). Usada pelos testes E2E.
# TMDB_API_URL=
